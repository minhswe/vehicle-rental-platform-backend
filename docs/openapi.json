{
  "openapi": "3.1.0",
  "info": {
    "title": "Vehicle Rental Platform Backend",
    "description": "REST API documentation for Vehicle Rental Platform.\n\nFeatures:\n- JWT Authentication\n- Refresh Token\n- User Profile\n- Address Management\n- Driver License Verification\n- Vehicle Rental\n",
    "contact": {
      "name": "MR.MINH PHAM",
      "email": "quangminhswe@gmail.com"
    },
    "license": {
      "name": "MIT License"
    },
    "version": "1.0"
  },
  "servers": [
    {
      "url": "http://localhost:8080",
      "description": "Local Development"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/users/me/driver-license": {
      "get": {
        "tags": [
          "driver-license-controller"
        ],
        "operationId": "getMyLicense",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/DriverLicenseResponse"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "driver-license-controller"
        ],
        "operationId": "upload",
        "parameters": [
          {
            "name": "licenseNumber",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "expiryDate",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date"
            }
          }
        ],
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "frontImage": {
                    "type": "string",
                    "format": "binary"
                  },
                  "backImage": {
                    "type": "string",
                    "format": "binary"
                  }
                },
                "required": [
                  "backImage",
                  "frontImage"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/DriverLicenseResponse"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "driver-license-controller"
        ],
        "operationId": "delete",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      },
      "patch": {
        "tags": [
          "driver-license-controller"
        ],
        "operationId": "update",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateDriverLicenseRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/DriverLicenseResponse"
                }
              }
            }
          }
        }
      }
    },
    "/users/me/driver-license/resubmit": {
      "post": {
        "tags": [
