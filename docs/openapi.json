  "components": {
    "schemas": {
      "UpdateVehicleRequest": {
        "type": "object",
        "properties": {
          "brand": {
            "type": "string"
          },
          "model": {
            "type": "string"
          },
          "year": {
            "type": "integer",
            "format": "int32"
          },
          "seatCount": {
            "type": "integer",
            "format": "int32"
          },
          "fuelType": {
            "type": "string",
            "enum": [
              "PETROL",
              "DIESEL",
              "ELECTRIC",
              "HYBRID"
            ]
          },
          "transmission": {
            "type": "string",
            "enum": [
              "MANUAL",
              "AUTOMATIC"
            ]
          },
          "mileage": {
            "type": "integer",
            "format": "int32"
          },
          "description": {
            "type": "string"
          },
          "pricePerDay": {
            "type": "number"
          },
          "depositAmount": {
            "type": "number"
          },
          "licensePlate": {
            "type": "string"
          }
        }
      },
      "ApiResponseVehicleResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "data": {
            "$ref": "#/components/schemas/VehicleResponse"
          },
          "message": {
            "type": "string"
          },
          "traceId": {
            "type": "string"
          },
          "errorCode": {
            "type": "string",
            "enum": [
              "VALIDATION_ERROR",
              "BAD_REQUEST",
              "UNAUTHORIZED",
              "FORBIDDEN",
              "NOT_FOUND",
              "INTERNAL_ERROR",
              "USER_NOT_FOUND",
              "EMAIL_ALREADY_EXISTS",
              "PHONE_ALREADY_EXISTS",
              "USER_ALREADY_EXISTS",
              "INVALID_CREDENTIALS",
              "USER_SUSPENDED",
              "INVALID_TOKEN",
              "TOKEN_EXPIRED",
              "TOKEN_REVOKED",
              "PASSWORDS_DO_NOT_MATCH",
              "CURRENT_PASSWORD_IS_INCORRECT",
              "NEW_PASSWORD_MUST_BE_DIFFERENT_FROM_CURRENT_PASSWORD",
              "PASSWORD_CHANGE_NOT_ALLOWED_FOR_SOCIAL_ACCOUNT",
              "FILE_EMPTY",
              "FILE_TOO_LARGE",
              "INVALID_IMAGE_URL",
              "FILE_UPLOAD_FAILED",
              "FILE_DELETE_FAILED",
              "ADDRESS_OR_USER_NOT_FOUND",
              "ADDRESS_NOT_FOUND",
              "DRIVER_LICENSE_ALREADY_EXISTS",
              "DRIVER_LICENSE_NOT_FOUND",
              "DRIVER_LICENSE_NOT_REJECTED",
              "OWNER_ALREADY_EXISTS",
              "OWNER_NOT_FOUND",
              "VEHICLE_NOT_FOUND",
              "VEHICLE_ACCESS_DENIED",
              "LICENSE_PLATE_ALREADY_EXISTS",
              "INVALID_VEHICLE_YEAR",
              "INVALID_LICENSE_PLATE",
              "VEHICLE_NOT_EDITABLE",
              "VEHICLE_NOT_DELETABLE"
            ]
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "VehicleResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "ownerId": {
            "type": "string",
            "format": "uuid"
          },
          "brand": {
            "type": "string"
          },
          "model": {
            "type": "string"
          },
          "year": {
            "type": "integer",
            "format": "int32"
          },
          "licensePlate": {
            "type": "string"
          },
          "seatCount": {
            "type": "integer",
            "format": "int32"
          },
          "fuelType": {
            "type": "string",
            "enum": [
              "PETROL",
              "DIESEL",
              "ELECTRIC",
              "HYBRID"
            ]
          },
          "transmission": {
            "type": "string",
            "enum": [
              "MANUAL",
              "AUTOMATIC"
            ]
          },
          "mileage": {
            "type": "integer",
            "format": "int32"
          },
          "description": {
            "type": "string"
          },
          "pricePerDay": {
            "type": "number"
          },
          "depositAmount": {
            "type": "number"
          },
          "status": {
            "type": "string",
            "enum": [
              "AVAILABLE",
              "UNAVAILABLE",
              "MAINTENANCE",
              "DELETED",
              "RENTED"
            ]
          }
        }
      },
      "CreateVehicleRequest": {
        "type": "object",
        "properties": {
          "brand": {
            "type": "string",
            "maxLength": 100,
            "minLength": 0
          },
          "model": {
            "type": "string",
            "maxLength": 100,
            "minLength": 0
          },
          "year": {
            "type": "integer",
            "format": "int32",
            "minimum": 1990
          },
          "licensePlate": {
            "type": "string",
            "maxLength": 20,
            "minLength": 0
          },
          "seatCount": {
            "type": "integer",
            "format": "int32"
          },
          "fuelType": {
            "type": "string",
            "enum": [
              "PETROL",
              "DIESEL",
              "ELECTRIC",
              "HYBRID"
            ]
          },
          "transmission": {
            "type": "string",
            "enum": [
              "MANUAL",
              "AUTOMATIC"
            ]
          },
          "mileage": {
            "type": "integer",
            "format": "int32"
          },
          "description": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 0
          },
          "pricePerDay": {
            "type": "number"
          },
          "depositAmount": {
            "type": "number"
          }
        },
        "required": [
          "brand",
          "depositAmount",
          "licensePlate",
          "mileage",
          "model",
          "pricePerDay",
          "year"
        ]
      },
      "DriverLicenseResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "licenseNumber": {
            "type": "string"
          },
          "frontImageUrl": {
            "type": "string"
          },
          "backImageUrl": {
            "type": "string"
          },
          "expiryDate": {
            "type": "string",
            "format": "date"
          },
          "licenseVerificationStatus": {
