  },
  "components": {
    "schemas": {
      "DriverLicenseResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "licenseNumber": {
            "type": "string"
          },
          "frontImageUrl": {
            "type": "string"
          },
          "backImageUrl": {
            "type": "string"
          },
          "expiryDate": {
            "type": "string",
            "format": "date"
          },
          "licenseVerificationStatus": {
            "type": "string",
            "enum": [
              "PENDING",
              "APPROVED",
              "REJECTED",
              "EXPIRED"
            ]
          },
          "verifiedAt": {
            "type": "string",
            "format": "date-time"
          },
          "verifiedBy": {
            "type": "string",
            "format": "uuid"
          },
          "rejectedReason": {
            "type": "string"
          }
        }
      },
      "UserProfileResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string"
          },
          "fullName": {
            "type": "string"
          },
          "phone": {
            "type": "string"
          },
          "avatarUrl": {
            "type": "string"
          }
        }
      },
      "CreateAddressRequest": {
        "type": "object",
        "properties": {
          "receiverName": {
            "type": "string",
            "minLength": 1
          },
          "phone": {
            "type": "string",
            "minLength": 1
          },
          "province": {
            "type": "string",
            "minLength": 1
          },
          "district": {
            "type": "string",
            "minLength": 1
          },
          "ward": {
            "type": "string",
            "minLength": 1
          },
          "detailAddress": {
            "type": "string",
            "minLength": 1
          },
          "default": {
            "type": "boolean"
          }
        },
        "required": [
          "detailAddress",
          "district",
          "phone",
          "province",
          "receiverName",
          "ward"
        ]
      },
      "AddressResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "receiverName": {
            "type": "string"
          },
          "phone": {
            "type": "string"
          },
          "province": {
            "type": "string"
          },
          "district": {
            "type": "string"
          },
          "ward": {
            "type": "string"
          },
          "detailAddress": {
            "type": "string"
          },
          "default": {
            "type": "boolean"
          }
        }
      },
      "RegisterRequest": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "minLength": 1
          },
          "password": {
            "type": "string"
          },
          "fullName": {
            "type": "string"
          },
          "phone": {
            "type": "string"
          }
        },
        "required": [
          "email"
        ]
      },
      "ApiResponseAuthResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "data": {
            "$ref": "#/components/schemas/AuthResponse"
          },
          "message": {
            "type": "string"
          },
          "traceId": {
            "type": "string"
          },
          "errorCode": {
            "type": "string",
            "enum": [
              "VALIDATION_ERROR",
              "BAD_REQUEST",
              "UNAUTHORIZED",
              "FORBIDDEN",
              "NOT_FOUND",
              "INTERNAL_ERROR",
              "USER_NOT_FOUND",
              "EMAIL_ALREADY_EXISTS",
              "PHONE_ALREADY_EXISTS",
              "USER_ALREADY_EXISTS",
              "INVALID_CREDENTIALS",
              "USER_SUSPENDED",
              "INVALID_TOKEN",
              "TOKEN_EXPIRED",
              "TOKEN_REVOKED",
              "PASSWORDS_DO_NOT_MATCH",
              "CURRENT_PASSWORD_IS_INCORRECT",
              "NEW_PASSWORD_MUST_BE_DIFFERENT_FROM_CURRENT_PASSWORD",
              "PASSWORD_CHANGE_NOT_ALLOWED_FOR_SOCIAL_ACCOUNT",
              "FILE_EMPTY",
              "FILE_TOO_LARGE",
              "INVALID_IMAGE_URL",
              "FILE_UPLOAD_FAILED",
              "FILE_DELETE_FAILED",
              "ADDRESS_OR_USER_NOT_FOUND",
              "ADDRESS_NOT_FOUND",
              "DRIVER_LICENSE_ALREADY_EXISTS",
              "DRIVER_LICENSE_NOT_FOUND",
              "DRIVER_LICENSE_NOT_REJECTED"
            ]
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "AuthResponse": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string"
          },
          "refreshToken": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "CUSTOMER",
              "ADMIN",
              "SUPER_ADMIN"
            ]
          },
          "fullName": {
            "type": "string"
          },
          "userId": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "RefreshTokenRequest": {
        "type": "object",
        "properties": {
          "refreshToken": {
            "type": "string"
          }
        }
      },
      "LogOutDeviceRequest": {
        "type": "object",
        "properties": {
          "refreshToken": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "refreshToken"
        ]
      },
      "LoginRequest": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          },
          "password": {
            "type": "string"
          }
        }
      },
      "UpdateProfileRequest": {
        "type": "object",
        "properties": {
          "fullName": {
            "type": "string"
          },
          "phone": {
            "type": "string"
          }
        }
      },
      "UpdateDriverLicenseRequest": {
        "type": "object",
        "properties": {
          "licenseNumber": {
            "type": "string",
            "pattern": "^[A-Z0-9-]{6,20}$"
          },
          "expiryDate": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "ChangePasswordRequest": {
        "type": "object",
        "properties": {
          "currentPassword": {
            "type": "string"
          },
          "newPassword": {
            "type": "string"
          }
        }
      },
      "UpdateAddressRequest": {
        "type": "object",
        "properties": {
          "receiverName": {
            "type": "string"
          },
          "phone": {
            "type": "string"
          },
          "province": {
            "type": "string"
          },
          "district": {
            "type": "string"
          },
          "ward": {
            "type": "string"
          },
          "detailAddress": {
            "type": "string"
          },
          "default": {
            "type": "boolean"
          }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "description": "Input JWT access token",
        "name": "bearerAuth",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  }
}