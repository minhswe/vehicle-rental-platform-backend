# Docker & Database Configuration (Local Offline Containerized PostgreSQL)
POSTGRES_DB=vehicle_rental_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DB_PORT=5432

# Spring Boot Datasource Connection
# For local running Spring Boot app outside Docker container:
DB_URL=jdbc:postgresql://localhost:5432/vehicle_rental_db
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Spring Profile Selection (Optionally set to 'local' or leave blank for default)
SPRING_PROFILES_ACTIVE=local

# JWT Secret & Token Expirations
JWT_SECRET_KEY=c3VwZXItc2VjcmV0LWtleS1mb3ItbG9jYWwtZGV2ZWxvcG1lbnQtMjU2Yml0cw==
ACCESS_TOKEN_EXPIRATION=15m
REFRESH_TOKEN_EXPIRATION=7d

# Cloudinary Setup (Optional for local UI testing)
CLOUDINARY_CLOUD_NAME=your_cloudinary_account
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
APP_UPLOAD_MAX_FILE_SIZE=10485760

# SonarQube Token
SONAR_TOKEN=your_sonar_token

# Business Domain Configurations
WALLET_HOLD_EXPIRATION_MINUTES=30
